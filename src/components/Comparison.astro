---
import site from "../data/site.json";
import { asset } from "../data/paths";
---

<div class="comparison">
  {
    site.comparisons.length > 1 && (
      <div class="tabs" role="tablist" aria-label="Result comparison" hidden>
        {site.comparisons.map((dataset, i) => (
          <button
            role="tab"
            id={`tab-${dataset.id}`}
            aria-controls={`panel-${dataset.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
          >
            {dataset.label}
          </button>
        ))}
      </div>
    )
  }
  {
    site.comparisons.map((dataset) => (
      <section
        class="comparison-panel"
        id={`panel-${dataset.id}`}
        data-comparison-panel
      >
        <>
          <h3>{dataset.label}</h3>
          <p>{dataset.summary}</p>
        </>
        <div class="chart-grid">
          {dataset.metrics.map((metric) => (
            <div class="bar-chart">
              <h4>
                {metric.title} <span>({metric.unit})</span>
              </h4>
              <p class="chart-direction">
                {metric.direction} · axis starts at 0
              </p>
              <ul>
                {dataset.labels.map((label, i) => (
                  <li>
                    <div class="bar-heading">
                      <span>{label}</span>
                      <strong>
                        {metric.values[i]}{" "}
                        <span class="sr-only">{metric.unit}</span>
                      </strong>
                    </div>
                    <div class="bar-track" aria-hidden="true">
                      <span
                        class:list={[
                          "bar",
                          { featured: i === dataset.featured },
                        ]}
                        style={`width:${(metric.values[i] / metric.max) * 100}%`}
                      />
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="fine-print">
          Source: {dataset.source} Values are labeled directly; bar shading is
          not needed to read the comparison.
        </p>
      </section>
    ))
  }
  <a class="text-link" href={asset("results/")}
    >Explore result tables and original figures <span aria-hidden="true">→</span
    ></a
  >
</div>
<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
  );
  const tablist = document.querySelector<HTMLElement>('[role="tablist"]');
  if (tabs.length && tablist) {
    tablist.hidden = false;
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const active = t === tab;
        t.setAttribute("aria-selected", String(active));
        t.tabIndex = active ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls")!);
        if (panel) {
          panel.hidden = !active;
          panel.setAttribute("role", "tabpanel");
          panel.setAttribute("aria-labelledby", t.id);
          panel.tabIndex = 0;
        }
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (event) => {
        const index =
          event.key === "ArrowRight"
            ? (i + 1) % tabs.length
            : event.key === "ArrowLeft"
              ? (i - 1 + tabs.length) % tabs.length
              : event.key === "Home"
                ? 0
                : event.key === "End"
                  ? tabs.length - 1
                  : -1;
        if (index >= 0) {
          event.preventDefault();
          select(tabs[index]);
          tabs[index].focus();
        }
      });
    });
    select(tabs[0]);
  }
</script>
