---
import site from "../data/site.json";
import { asset } from "../data/paths";
import media from "../../public/media/roofing-clips.json";

const fieldClips = media.clips.filter((clip) =>
  clip.id.startsWith("roofing-fieldwork"),
);
const robotClips = media.clips.filter((clip) => clip.section === "results");
const opening = media.clips.find((clip) => clip.id === "roofing-film")!;
const framework = site.figures.find((figure) => figure.id === "framework")!;
---

<section
  id="media-description"
  class="media-description"
  aria-labelledby="media-heading"
>
  <p class="eyebrow">Recorded by our team</p>
  <h2 id="media-heading">Video descriptions & sources</h2>
  <p>
    These independent excerpts play silently at original speed when visible,
    unless reduced motion or data saving is enabled. Use each player’s native
    controls to pause or resume. Manual pauses are remembered when scrolling.
    Laboratory clips are cropped to the robot: the safety tether remains visible,
    and the operator stands just outside the frame.
  </p>
  <section aria-labelledby="field-media-title">
    <h3 id="field-media-title">Roofing fieldwork</h3>
    <p>{site.contextCredit}</p>
    <div id="field-visual-description">
      {
        fieldClips.map((clip) => (
          <section aria-labelledby={`${clip.id}-credit-title`}>
            <h4 id={`${clip.id}-credit-title`}>{clip.title}</h4>
            <p id={`${clip.id}-visual-description`}>{clip.description}</p>
            <p>
              <a
                href={asset(`#${clip.section}`)}
              >
                Watch {clip.title.toLowerCase()} on the project page
              </a>
            </p>
          </section>
        ))
      }
    </div>
    <p class="fine-print">
      Source: the research team’s original field recording, <code
        >IMG_7082 (1).MOV</code
      >, <code>IMG_7081.MOV</code>, <code>IMG_7082.MOV</code> and <code>IMG_7085.MOV</code>. Web excerpts use its silent browser viewing copy. Original recordings
      remain unchanged.
    </p>
  </section>
  <section aria-labelledby="robot-media-title">
    <h3 id="robot-media-title">{opening.title}</h3>
    <p id="robot-visual-description">{opening.description}</p>
    <p class="fine-print">
      Source: the research team’s field recording and the authors’ laboratory
      recording, <code
        >bending_real_test_20260905_185804_260763_nailgun.mp4</code
      >. Excerpts are joined with hard cuts at original speed.
    </p>
  </section>
  <section aria-labelledby="framework-media-title">
    <h3 id="framework-media-title">Paper figure {framework.number}</h3>
    <p>{framework.description}</p>
    <p class="fine-print">{framework.credit}</p>
  </section>
  <section aria-labelledby="highlights-media-title">
    <h3 id="highlights-media-title">Roofer and G1 pairs</h3>
    <div id="highlights-visual-description">
      {
        robotClips.map((clip) => (
          <section aria-labelledby={`${clip.id}-credit-title`}>
            <h4 id={`${clip.id}-credit-title`}>{clip.title}</h4>
            <p id={`${clip.id}-visual-description`}>{clip.description}</p>
            <p class="fine-print">
              Source: <code>{clip.sourceFile}</code>.
            </p>
            <p>
              <a href={asset(`#${clip.section}`)}>
                Watch {clip.title.toLowerCase()} in the results
              </a>
            </p>
          </section>
        ))
      }
    </div>
    <p class="fine-print">
      Excerpts illustrate selected supervised movements, rather than complete
      trials or independent roofing work. They end before later falls or resets.
      Source recordings remain unchanged; the original paper reports the
      experimental evaluation.
    </p>
  </section>
</section>
