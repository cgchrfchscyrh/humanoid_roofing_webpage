---
import site from "../data/site.json";
import { asset } from "../data/paths";
---

<section
  id="media-description"
  class="media-description"
  aria-labelledby="media-heading"
>
  <p class="eyebrow">Recorded by our team</p>
  <h2 id="media-heading">Video description & credit</h2>
  <p>{site.contextCredit}</p>
  {site.contextDetails.map((p) => <p>{p}</p>)}
  <p class="fine-print">{site.contextLicense}</p>
  <p>
    <a href={asset(site.contextVideo)} download
      >Download the silent roofing field video (MP4)</a>
  </p>
</section>
