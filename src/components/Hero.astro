---
import site from "../data/site.json";
import clips from "../../public/media/roofing-clips.json";
import MotionClip from "./MotionClip.astro";
const field = clips.clips.find((clip) => clip.section === "hero")!;
const robot = {
  video: site.robotHero.video.replace("media/", ""),
  poster: site.robotHero.poster.replace("media/", ""),
  track: site.robotHero.track.replace("media/", ""),
  width: 1280,
  height: 720,
  duration: site.robotHero.duration,
  caption: "G1 reproduces a roofing motion on a laboratory slope.",
  description: site.robotHero.description,
};
---

<section class="hero cinematic-hero" aria-labelledby="paper-title">
  <div class="hero-stage" id="hero-stage">
    <div class="hero-text">
      <h1 id="paper-title">{site.title}</h1>
      <ul class="authors">
        {
          site.authors.map((author) => (
            <li>
              <a href={"mailto:" + author.email}>{author.name}</a>
            </li>
          ))
        }
      </ul>
      <div class="actions">
        <a class="button dark" href={site.paperUrl}
          >arXiv <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
    <div class="hero-backdrops">
      <MotionClip
        id="context-video"
        clip={field}
        group="hero"
        preload="metadata"
      />
      <MotionClip
        id="g1-hero-video"
        clip={robot}
        group="hero"
        preload="metadata"
      />
    </div>
  </div>
  <p id="media-status" class="sr-only" role="status"></p>
</section>
