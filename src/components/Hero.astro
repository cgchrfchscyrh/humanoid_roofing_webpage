---
import site from "../data/site.json";
import { asset } from "../data/paths";
---

<section class="hero cinematic-hero" aria-labelledby="paper-title">
  <div class="hero-stage" id="hero-stage">
    <div class="hero-text">
      <p class="eyebrow">Humanoid roofing</p>
      <h1 id="paper-title">{site.title}</h1>
      <ul class="authors">
        {
          site.authors.map((author) => (
            <li>
              <a href={"mailto:" + author.email}>{author.name}</a>
            </li>
          ))
        }
      </ul>
      <p class="publication-line">arXiv · {site.year}</p>
      <div class="actions">
        <a class="button light" href={site.paperUrl}
          >Paper <span aria-hidden="true">↗</span></a
        >
        <a class="button light" href="#experiments"
          >Experiments <span aria-hidden="true">↓</span></a
        >
        <a class="button light" href={site.repo}
          >Website source <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
    <div class="hero-backdrops">
      <video
        id="context-video"
        data-playback-group="hero"
        controls
        muted
        loop
        playsinline
        preload="metadata"
        poster={asset(site.contextPoster)}
        width="1280"
        height="720"
        aria-label="Research-team roofing fieldwork"
        aria-describedby="context-summary"
      >
        <source src={asset(site.contextVideo)} type="video/mp4" />
        <track
          kind="descriptions"
          src={asset(site.contextTrack)}
          srclang="en"
          label="English visual descriptions"
        />
        <a href={asset(site.contextVideo)}>Download the roofing field video.</a>
      </video>
      <video
        id="g1-hero-video"
        data-playback-group="hero"
        controls
        muted
        loop
        playsinline
        preload="metadata"
        poster={asset(site.robotHero.poster)}
        width="1280"
        height="720"
        aria-label="Unitree G1 laboratory motion excerpt"
        aria-describedby="robot-summary"
      >
        <source src={asset(site.robotHero.video)} type="video/mp4" />
        <track
          kind="descriptions"
          src={asset(site.robotHero.track)}
          srclang="en"
          label="English visual descriptions"
        />
        <a href={asset(site.robotHero.video)}
          >Download the G1 laboratory excerpt.</a
        >
      </video>
    </div>
  </div>
  <div class="hero-scene-captions">
    <p id="context-summary">Human roofing</p><p id="robot-summary">
      G1 laboratory motion · Safety hoist attached
    </p>
  </div>
  <div class="hero-playback">
    <a href={asset("accessibility/#media-description")}
      >Video descriptions & sources</a
    >
  </div>
  <p id="media-status" class="sr-only" role="status"></p>
</section>
