---
import stories from "../data/vision-stories.json";
import site from "../data/site.json";
import clips from "../../public/media/roofing-clips.json";
import MotionClip from "./MotionClip.astro";
const field = clips.clips.find((clip) => clip.id === "roofing-fieldwork-opening")!;
const film = clips.clips.find((clip) => clip.id === "roofing-film")!;
---

<section class="hero-film-section" aria-labelledby="paper-title">
  <div class="hero-film hero-pair" id="hero">
    <MotionClip id="hero-field-video" clip={field} group="hero" />
    <MotionClip id="hero-film-video" clip={film} group="hero" />
  </div>
  <div class="hero-publication">
    <h1 id="paper-title" class="project-display-title">{stories.roof.headline}</h1>
    <ul class="authors">
      {
        site.authors.map((author) => (
          <li>
            <a href={"mailto:" + author.email}>{author.name}</a>
          </li>
        ))
      }
    </ul>
    <div class="actions">
      <a class="button dark" href={site.paperUrl}
        >arXiv <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
  <p id="media-status" class="sr-only" role="status"></p>
</section>
