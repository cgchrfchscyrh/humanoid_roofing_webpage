---
import site from "../data/site.json";
import { asset } from "../data/paths";
---

<figure class="experiment-video">
  <video
    id="g1-highlights-video"
    data-playback-group="experiment"
    controls
    muted
    loop
    playsinline
    preload="metadata"
    poster={asset(site.robotHighlights.poster)}
    width="1280"
    height="720"
    aria-label="G1 physical experiment highlights"
    aria-describedby="experiment-caption"
  >
    <source src={asset(site.robotHighlights.video)} type="video/mp4" />
    <track
      kind="descriptions"
      src={asset(site.robotHighlights.track)}
      srclang="en"
      label="English visual descriptions"
    />
    <a href={asset(site.robotHighlights.video)}
      >Download G1 experiment highlights.</a
    >
  </video>
  <figcaption id="experiment-caption">
    Incline walking · Tool positioning · Bending
  </figcaption>
</figure>
<p class="media-description-link">
  <a href={asset("accessibility/#highlights-visual-description")}
    >Video description and recording sources</a
  >
</p>
