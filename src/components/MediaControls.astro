<script>
  const videos = [
    ...document.querySelectorAll<HTMLVideoElement>(
      "video[data-playback-group]",
    ),
  ];
  const status = document.querySelector<HTMLElement>("#media-status");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const connection = (
    navigator as Navigator & {
      connection?: EventTarget & { saveData?: boolean };
    }
  ).connection;
  const state = new Map(
    videos.map((video) => [
      video,
      { visible: false, manualPause: false, explicitPlayback: false },
    ]),
  );
  const systemPauses = new WeakSet<HTMLVideoElement>();
  const systemPlays = new WeakSet<HTMLVideoElement>();
  const automaticPlaybackAllowed = () =>
    !reduced.matches && !connection?.saveData;
  const pause = (video: HTMLVideoElement) => {
    if (!video.paused) {
      systemPauses.add(video);
      video.pause();
    }
  };
  const play = (video: HTMLVideoElement) => {
    if (!video.paused) return;
    video.muted = true;
    systemPlays.add(video);
    video
      .play()
      .then(() => {
        const item = state.get(video)!;
        if (
          document.hidden ||
          !item.visible ||
          item.manualPause ||
          (!item.explicitPlayback && !automaticPlaybackAllowed())
        )
          pause(video);
      })
      .catch((error: DOMException) => {
        systemPlays.delete(video);
        if (error.name !== "AbortError" && status)
          status.textContent =
            "Automatic playback is unavailable. Use the native player controls.";
      });
  };
  const sync = () => {
    for (const video of videos) {
      const item = state.get(video)!;
      if (!item.visible || document.hidden) item.explicitPlayback = false;
      if (
        !document.hidden &&
        item.visible &&
        !item.manualPause &&
        (item.explicitPlayback || automaticPlaybackAllowed())
      )
        play(video);
      else pause(video);
    }
  };
  for (const video of videos) {
    video.addEventListener("pause", () => {
      if (!systemPauses.has(video) && !video.ended) {
        state.get(video)!.manualPause = true;
        state.get(video)!.explicitPlayback = false;
      }
      systemPauses.delete(video);
    });
    video.addEventListener("play", () => {
      if (!systemPlays.has(video)) {
        // Native play explicitly opts this player in, even with motion/data saving.
        state.get(video)!.manualPause = false;
        state.get(video)!.explicitPlayback = true;
        if (status) status.textContent = "";
      }
      systemPlays.delete(video);
    });
  }
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries)
        state.get(entry.target as HTMLVideoElement)!.visible =
          entry.isIntersecting && entry.intersectionRatio >= 0.12;
      sync();
    },
    { threshold: [0, 0.12] },
  );
  videos.forEach((video) => observer.observe(video));
  document.addEventListener("visibilitychange", sync);
  const preferenceChanged = () => {
    state.forEach((item) => {
      item.explicitPlayback = false;
    });
    sync();
  };
  reduced.addEventListener("change", preferenceChanged);
  connection?.addEventListener("change", preferenceChanged);
</script>
