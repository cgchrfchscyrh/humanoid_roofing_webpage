---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";
import { asset } from "../data/paths";
---

<Layout
  title={`Method — ${site.wordmark}`}
  description="Explore the method on the roofing project page."
  canonicalPath={asset()}
  noindex
>
  <div class="reading-container">
    <header class="page-title">
      <h1>Explore the method</h1>
      <p class="lead">The project’s method is now part of the main page.</p>
      <div class="actions">
        <a class="button dark" href={asset("#method")}>Go to Method</a>
      </div>
    </header>
  </div>
</Layout>
