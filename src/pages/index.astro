---
import stories from "../data/vision-stories.json";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Figure from "../components/Figure.astro";
import Citation from "../components/Citation.astro";
import MotionClip from "../components/MotionClip.astro";
import MediaControls from "../components/MediaControls.astro";
import clips from "../../public/media/roofing-clips.json";
import evidence from "../data/evidence.json";
const pairs = clips.clips.filter((clip) => clip.section === "results");
---

<Layout title={stories.roof.headline} bare>
  <Hero />
  <div class="container visual-home">
    <section class="section evidence-section" id="florida" aria-labelledby="florida-title">
      <h2 id="florida-title">Hurricanes leave Florida with thousands of damaged roofs.</h2>
      <div class="evidence-grid">
        {evidence.florida.map(tile => <article class="evidence-tile">
          <h3>{tile.label}</h3>
          <p class="evidence-value">{tile.value}</p>
          <p class="evidence-text">{tile.text}</p>
          <a href={tile.source} aria-label={`Source for ${tile.label}: ${tile.sourceName}`}>Source ↗</a>
        </article>)}
      </div>
    </section>
    <section class="section evidence-section" id="four-d" aria-labelledby="four-d-title">
      <h2 id="four-d-title">Roofing is a 4D task: dull, dirty, dangerous, and demanding.</h2>
      <div class="evidence-grid">
        {evidence.fourD.map(tile => <article class="evidence-tile">
          <h3>{tile.label}</h3>
          <p class="evidence-value">{tile.value}</p>
          <p class="evidence-text">{tile.text}</p>
          <a href={tile.source} aria-label={`Source for ${tile.label}: ${tile.sourceName}`}>Source ↗</a>
        </article>)}
      </div>
    </section>
    <section class="section" id="method" aria-labelledby="method-title">
      <h2 id="method-title">We teach humanoid robots to perform roofing tasks through human demonstrations.</h2>
      <div class="method-map">
        <div class="method-map-figure"><Figure id="framework" compact bare /></div>
        <h3 class="sr-only">What the figure shows</h3>
        <p class="method-bubble method-bubble-capture">
          <span class="method-badge"><span class="sr-only">Figure panel </span>0</span>
          <strong>Motion capture.</strong> PICO VR tracking records a person performing roofing motions.
        </p>
        <p class="method-bubble method-bubble-retarget">
          <span class="method-badge"><span class="sr-only">Figure panel </span>1</span>
          <strong>Motion retargeting.</strong> The human motion is extracted and retargeted to the Unitree G1.
        </p>
        <p class="method-bubble method-bubble-refine">
          <span class="method-badge"><span class="sr-only">Figure panel </span>2</span>
          <strong>Reference refinement.</strong> A metric roof mesh sets foot support and task-specific hand clearance across the whole trajectory.
        </p>
        <p class="method-bubble method-bubble-simulate">
          <span class="method-badge"><span class="sr-only">Figure panel </span>3</span>
          <strong>Policy learning in simulation.</strong> Reinforcement learning tracks the refined reference. Extra rewards hold hand clearance and prevent hand-mesh penetration.
        </p>
        <p class="method-bubble method-bubble-robot">
          <span class="method-badge"><span class="sr-only">Figure panel </span>4</span>
          <strong>Physical tests.</strong> Uphill walking, nailgun positioning, hammering, and bending on a foam wedge, with a safety hoist attached.
        </p>
      </div>
    </section>
    <section class="section" id="results" aria-labelledby="results-title">
      <h2 id="results-title">A real humanoid reproduces roofing motions on a slope.</h2>
      <div class="motion-grid pair-grid" id="experiments">
        {pairs.map((clip) => (
          <div class="clip-with-bubble">
            <h3>{clip.title}</h3>
            <MotionClip id={`${clip.id.replace("roofing-", "")}-video`} clip={clip} />
          </div>
        ))}
      </div>
    </section>
    <Citation />
  </div>
  <MediaControls />
</Layout>
