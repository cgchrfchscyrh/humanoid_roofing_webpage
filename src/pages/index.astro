---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Figure from "../components/Figure.astro";
import Citation from "../components/Citation.astro";
import MotionClip from "../components/MotionClip.astro";
import MediaControls from "../components/MediaControls.astro";
import clips from "../../public/media/roofing-clips.json";
const walking = clips.clips.find((clip) => clip.id === "g1-roofing-walking")!;
const field = clips.clips.find(
  (clip) => clip.id === "roofing-fieldwork-crouch",
)!;
const tool = clips.clips.find((clip) => clip.id === "g1-roofing-tool")!;
const bending = clips.clips.find((clip) => clip.id === "g1-roofing-bending")!;
---

<Layout>
  <Hero />
  <div class="container visual-home">
    <section
      class="section abstract-section"
      id="abstract"
      aria-labelledby="abstract-title"
    >
      <h2 id="abstract-title">Abstract</h2>
      <div class="abstract-story">
        <div class="abstract-copy">
          <p class="lead">
            Roofing requires a robot to coordinate movement, balance, and tool
            positioning on a slope. Human demonstrations capture this
            coordination, but retargeted poses can misplace feet or hands
            relative to the roof.
          </p>
          <p>
            We ground human motion in a metric roof model, refine support and
            work-surface relations, and learn feedback policies that preserve
            them during execution. Simulation and physical Unitree G1
            experiments demonstrate roofing-oriented motion primitives.
          </p>
          <Figure id="overview" compact />
        </div>
        <MotionClip id="g1-walking-video" clip={walking} />
      </div>
    </section>
    <section class="section" id="method" aria-labelledby="method-title">
      <h2 id="method-title">Method</h2>
      <p class="section-intro">
        Learn the coordination from people, and ground each movement in the roof
        geometry.
      </p>
      <Figure id="framework" compact />
      <div class="method-story">
        <ol class="method-summary">
          <li>
            <h3>Demonstrate</h3><p>
              PICO tracking captures human motion and timing.
            </p>
          </li>
          <li>
            <h3>Refine</h3><p>
              Roof geometry constrains support, hand clearance, and
              nonpenetration.
            </p>
          </li>
          <li>
            <h3>Learn</h3><p>
              Execution-aware rewards preserve these relations during motion.
            </p>
          </li>
        </ol>
        <MotionClip id="field-crouch-video" clip={field} />
      </div>
    </section>
    <section class="section" id="results" aria-labelledby="results-title">
      <h2 id="results-title">Results</h2>
      <p class="section-intro">
        From walking on an incline to positioning a tool near the work surface.
      </p>
      <div class="motion-grid" id="experiments">
        <MotionClip id="g1-tool-video" clip={tool} />
        <MotionClip id="g1-bending-video" clip={bending} />
      </div>
      <p class="experiment-note">
        Selected movements on the physical G1, with an overhead safety hoist and
        operator-controlled activation.
      </p>
      <details class="research-details">
        <summary>Study scope</summary>
        <p>
          The study evaluates slope traversal, working postures, and tool
          positioning under controlled conditions. These excerpts end after the
          selected movements and omit later trial outcomes and resets. They do
          not demonstrate functional fastening, hammer impact, or a complete
          autonomous roofing workflow.
        </p>
      </details>
    </section>
    <Citation />
  </div>
  <MediaControls />
</Layout>
