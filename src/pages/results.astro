---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";
import { asset } from "../data/paths";
---

<Layout
  title={`Results — ${site.wordmark}`}
  description="Watch the demonstrations on the roofing project page."
  canonicalPath={asset()}
  noindex
>
  <div class="reading-container">
    <header class="page-title">
      <h1>Explore the results</h1>
      <p class="lead">
        The project’s demonstrations are now part of the main page.
      </p>
      <div class="actions">
        <a class="button dark" href={asset("#results")}>Go to Results</a>
      </div>
    </header>
  </div>
</Layout>
